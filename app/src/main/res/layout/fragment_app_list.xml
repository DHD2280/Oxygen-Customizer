<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbarLayout" />

    <it.dhd.oxygencustomizer.ui.widgets.SwitchWidget
        android:id="@+id/app_function_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:forcePosition="top"
        app:iconSpaceReserved="false" />

    <LinearLayout
        android:id="@+id/edittext_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/preference_card_margin_horizontal"
        android:background="@drawable/preference_background_bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/preference_title_padding_start"
        android:paddingEnd="@dimen/preference_title_padding_end">

        <View
            style="@style/HorizontalDivider"
            android:layout_width="match_parent" />

        <it.dhd.oneplusui.appcompat.edittext.OplusEditText
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginStart="@dimen/oplus_input_button_layout_margin_start"
            android:layout_marginEnd="@dimen/oplus_input_button_layout_margin_start"
            android:focusable="true"
            android:hint="@string/searchpreference_search"
            android:singleLine="true"
            app:hintEnabled="true"
            app:quickDelete="true" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:dividerColor="@color/colorDivider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/preference_card_margin_horizontal" />

</LinearLayout>