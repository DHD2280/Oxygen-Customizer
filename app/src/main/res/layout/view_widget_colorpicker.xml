<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/preference_card_margin_horizontal"
    android:background="@drawable/preference_background_center"
    android:clickable="true"
    android:paddingStart="@dimen/preference_title_padding_start"
    android:paddingEnd="@dimen/preference_title_padding_end"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/icon"
        style="@style/PreferenceIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_container" />

    <LinearLayout
        android:id="@+id/text_container"
        style="@style/PreferenceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/color_widget"
        android:layout_toEndOf="@id/icon"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@+id/color_widget"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            style="@style/PreferenceTitleStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/summary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/summary"
            style="@style/PreferenceSummaryStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

    </LinearLayout>

    <com.jaredrummler.android.colorpicker.ColorPanelView
        android:id="@+id/color_widget"
        android:layout_width="@dimen/cpv_color_preference_normal"
        android:layout_height="@dimen/cpv_color_preference_normal"
        app:cpv_borderColor="@color/text_color_primary"
        app:cpv_colorShape="circle"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_container" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_container">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enable_button"
            style="@style/Widget.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/btn_apply"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disable_button"
            style="@style/Widget.MaterialButton.Red"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/btn_disable"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>