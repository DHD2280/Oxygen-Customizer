<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:tag="clock_container"
        android:visibility="gone">

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:gravity="center_horizontal"
            android:tag="clock_hours_tick"
            android:textColor="#00000000"
            android:textSize="60dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/slateforoneplus"
                android:gravity="center_horizontal"
                android:tag="clock_hours_text"
                android:textColor="#FFFFFF"
                android:textSize="60sp" />

            <TextClock
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/slateforoneplus"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:gravity="center_horizontal"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="12dp"
        android:gravity="bottom"
        android:orientation="vertical"
        android:tag="full_media_player">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/kg_widget_main_width"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="22dp"
            android:tag="album_art_big"
            android:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:tag="title_big"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:visibility="visible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:tag="album_big"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:orientation="vertical"
            android:tag="big_media_player"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="compact_infos"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_horizontal"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="title_medium"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_horizontal"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="album_medium"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:tag="app_infos"
                android:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:tag="app_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:tag="app_name"
                    android:text=""
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                android:tag="seek_bar_container" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="current_position"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:tag="total_duration"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="12dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:tag="buttons_container">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="space_action_1"
                    android:visibility="gone" />

                <ImageButton
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:background="@null"
                    android:clickable="true"
                    android:importantForAccessibility="no"
                    android:tag="action1"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:background="@null"
                    android:clickable="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_previous"
                    android:tag="previous_big" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:background="@drawable/ic_play"
                    android:clickable="true"
                    android:importantForAccessibility="no"
                    android:tag="big_playpause" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:background="@null"
                    android:clickable="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_next"
                    android:tag="next_big" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:layout_width="@dimen/nowbar_media_buttons_size_big"
                    android:layout_height="@dimen/nowbar_media_buttons_size_big"
                    android:background="@null"
                    android:clickable="true"
                    android:importantForAccessibility="no"
                    android:tag="action2"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="space_action_2"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:tag="little_media_player"
        android:visibility="visible">

        <ImageView
            android:layout_width="@dimen/nowbar_album_art_size"
            android:layout_height="@dimen/nowbar_album_art_size"
            android:layout_gravity="center_vertical"
            android:layout_marginVertical="12dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:tag="albumArt" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:tag="trackTitle"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:tag="buttons_container">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageButton
                        android:layout_width="@dimen/nowbar_media_buttons_size"
                        android:layout_height="@dimen/nowbar_media_buttons_size"
                        android:background="@null"
                        android:clickable="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_previous"
                        android:tag="previous_action" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageButton
                        android:layout_width="@dimen/nowbar_media_buttons_size"
                        android:layout_height="@dimen/nowbar_media_buttons_size"
                        android:background="@drawable/ic_play"
                        android:clickable="true"
                        android:importantForAccessibility="no"
                        android:tag="play_pause" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageButton
                        android:layout_width="@dimen/nowbar_media_buttons_size"
                        android:layout_height="@dimen/nowbar_media_buttons_size"
                        android:background="@null"
                        android:clickable="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_next"
                        android:tag="next_action" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>