<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_preference"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_dialog_toolbar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/add_widget"
            app:titleCentered="true" />

        <ImageButton
            android:id="@+id/apply_button"
            android:layout_width="@dimen/list_dialog_toolbar_height"
            android:layout_height="@dimen/list_dialog_toolbar_height"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:src="@drawable/check_mark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/system_accent1_400" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="@dimen/list_dialog_toolbar_height"
            android:layout_height="@dimen/list_dialog_toolbar_height"
            android:layout_marginEnd="12dp"
            android:background="@null"
            android:src="@drawable/ic_clear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/system_accent1_400" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View style="@style/HorizontalDivider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/select_dialog_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/list_dialog_list_margin_bottom"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:divider="@null"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical" />
</LinearLayout>