<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <it.dhd.oxygencustomizer.ui.preferences.ImageIllustrationPreference
        android:key="now_bar_illustration"
        app:backgroundResource="@drawable/ic_keyguard_layer"
        app:imageResource="@drawable/ic_now_bar_layer" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory>

        <it.dhd.oneplusui.preference.OplusSwitchPreference
            android:defaultValue="false"
            android:key="lockscreen_now_bar_enabled"
            android:summaryOff="@string/general_off"
            android:summaryOn="@string/general_on"
            android:title="@string/lockscreen_now_bar_enabled_title" />

        <it.dhd.oneplusui.preference.OplusSwitchPreference
            android:defaultValue="false"
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_weather"
            android:summary="@string/lockscreen_now_bar_weather_summary"
            android:title="@string/lockscreen_now_bar_weather" />

        <it.dhd.oneplusui.preference.OplusSwitchPreference
            android:defaultValue="false"
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_notifications"
            android:summary="@string/lockscreen_now_bar_notifications_summary"
            android:title="@string/lockscreen_now_bar_notifications" />

    </it.dhd.oneplusui.preference.OplusPreferenceCategory>

    <it.dhd.oneplusui.preference.OplusPreferenceCategory>

        <it.dhd.oneplusui.preference.OplusSliderPreference
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_bottom_margin"
            android:title="@string/lockscreen_now_bar_bottom_margin"
            app:defaultValue="12"
            app:maxVal="200"
            app:minVal="0"
            app:tickInterval="1" />

        <it.dhd.oneplusui.preference.OplusSliderPreference
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_side_margin"
            android:summary="@string/lockscreen_now_bar_side_margin_summary"
            android:title="@string/lockscreen_now_bar_side_margin"
            app:defaultValue="0"
            app:maxVal="100"
            app:minVal="-100"
            app:tickInterval="1" />

        <it.dhd.oneplusui.preference.OplusSwitchPreference
            android:defaultValue="false"
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_liquid_glass"
            android:summary="@string/lockscreen_now_bar_liquid_glass_summary"
            android:title="@string/lockscreen_now_bar_liquid_glass" />

        <it.dhd.oneplusui.preference.OplusSliderPreference
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_glass_tint"
            android:title="@string/lockscreen_now_bar_glass_tint"
            app:defaultValue="40"
            app:maxVal="100"
            app:minVal="0"
            app:tickInterval="1"
            app:valueFormat="%" />

        <it.dhd.oneplusui.preference.OplusSwitchPreference
            android:defaultValue="false"
            android:dependency="lockscreen_now_bar_enabled"
            android:key="lockscreen_now_bar_glass_rim_tint"
            android:summary="@string/lockscreen_now_bar_glass_rim_summary"
            android:title="@string/lockscreen_now_bar_glass_rim" />

    </it.dhd.oneplusui.preference.OplusPreferenceCategory>

    <it.dhd.oneplusui.preference.OplusPreferenceCategory android:title="@string/lockscreen_now_bar_pages">

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:dependency="lockscreen_now_bar_enabled"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.lockscreen.NowBarMusicFragment"
            android:key="lockscreen_now_bar_music_page"
            android:title="@string/lockscreen_now_bar_music" />

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:dependency="lockscreen_now_bar_enabled"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.lockscreen.NowBarBatteryFragment"
            android:key="lockscreen_now_bar_battery_page"
            android:title="@string/lockscreen_now_bar_battery" />

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:dependency="lockscreen_now_bar_weather"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.lockscreen.NowBarWeatherFragment"
            android:key="lockscreen_now_bar_weather_page"
            android:title="@string/lockscreen_now_bar_weather_category" />

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:dependency="lockscreen_now_bar_notifications"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.lockscreen.NowBarNotificationFragment"
            android:key="lockscreen_now_bar_notification_page"
            android:title="@string/lockscreen_now_bar_notifications_category" />

    </it.dhd.oneplusui.preference.OplusPreferenceCategory>

    <it.dhd.oxygencustomizer.ui.preferences.FooterPreference
        android:key="footer"
        android:title="@string/lockscreen_now_bar_footer" />

</PreferenceScreen>