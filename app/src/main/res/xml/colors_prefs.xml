<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:search="http://schemas.android.com/apk/it.dhd.oxygencustomizer.ui.preferences.preferencesearch">

    <it.dhd.oxygencustomizer.ui.preferences.IllustrationPreference
        android:key="sb_illustration"
        app:lottie_cacheComposition="false"
        app:lottie_rawRes="@raw/themes_illustration" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory android:title="@string/colors" />

    <it.dhd.oxygencustomizer.ui.preferences.OplusColorPreference
        android:key="primary_color"
        android:title="@string/primary_color"
        app:cpv_showAlphaSlider="true"
        app:forcePosition="full" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory/>

    <it.dhd.oneplusui.preference.OplusPreference
        android:key="apply_colors"
        android:title="@string/apply_color"
        app:centerTitle="true"
        app:iconSpaceReserved="false"
        app:forcePosition="full"
        app:tintTitle="true" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory android:title="@string/theming_packs">

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:icon="@drawable/ic_icon_packs"
            android:key="iconpacks"
            android:title="@string/icon_packs_title"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.theming.iconpack.IconPackFragment"
            search:ignore="true" />

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:icon="@drawable/ic_notification_style"
            android:key="notification_style_packs"
            android:title="@string/notification_style_packs_title"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.theming.notificationstyle.NotificationStylePackFragment"
            search:ignore="true" />

        <it.dhd.oneplusui.preference.OplusJumpPreference
            android:icon="@drawable/ic_qs"
            android:key="qs_style_packs"
            android:title="@string/qs_style_packs_title"
            android:fragment="it.dhd.oxygencustomizer.ui.fragments.mods.theming.qsstyle.QsStylePackFragment"
            search:ignore="true" />

    </it.dhd.oneplusui.preference.OplusPreferenceCategory>

</PreferenceScreen>